PORT=3000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/collabrix

ACCESS_TOKEN=change_me_access_jwt_secret
REFRESH_TOKEN=change_me_refresh_jwt_secret
RESET_TOKEN_SECRET=change_me_reset_secret

# Used when NODE_ENV=production for CORS + cookies. Comma-separated for multiple deploy URLs.
FRONTEND_URL=http://localhost:5173
# Optional extra production origins (comma-separated). Dev: any localhost / 127.0.0.1 + Vite port is allowed.
CORS_ORIGINS=

# Workspace AI (FastAPI) — browser calls Node only; Node proxies here.
AI_SERVICE_URL=http://127.0.0.1:8001
# Optional but recommended in production: same value as ai_backend INTERNAL_API_SECRET
AI_SERVICE_SECRET=
# Optional: ms timeouts for Node → FastAPI (defaults 300000 = 5 min). Raise if you still see axios timeouts.
# AI_QUERY_TIMEOUT_MS=600000
# AI_SUMMARIZE_TIMEOUT_MS=600000
# AI_TRANSCRIBE_TIMEOUT_MS=900000
