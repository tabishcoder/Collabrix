DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/collabrix_ai
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
GEMINI_MODEL=models/gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
RETRIEVAL_TOP_K=6
MAX_CONTEXT_CHARS=14000
# Max knowledge rows scanned per question (lower = faster workspace Q&A)
RETRIEVAL_CANDIDATE_LIMIT=72

# Optional: when set, Node must send header X-Internal-Secret with the same value (see backend AI_SERVICE_SECRET).
INTERNAL_API_SECRET=

# Local speech-to-text (free on your machine) — pip install faster-whisper; first run downloads model weights.
# WHISPER_MODEL=tiny|base|small|medium (base is a good student default on CPU)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TRANSCRIBE_MAX_BYTES=125829120
