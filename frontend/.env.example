# Put this file next to vite.config.js as `.env` (frontend root). Vite does NOT load `src/.env`.

# Local dev (recommended): same-origin — Vite proxies /api and /socket.io to the Node server so cookies work.
VITE_API_URL=/api

# Production: your deployed API, e.g. https://api.example.com/api
# VITE_API_URL=https://api.example.com/api

# Optional: backend URL for the dev proxy (default matches backend PORT 5000)
# VITE_PROXY_TARGET=http://127.0.0.1:5000
